{
  "name": "dsh-orchestrator",
  "version": "0.1.0-alpha.1",
  "description": "Evidence-driven pipelines for DeepSeek Harness with a portable core",
  "type": "module",
  "main": "src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./core": "./src/core.js",
    "./driver": "./src/driver.js",
    "./template": "./src/template.js",
    "./viewer": "./src/viewer.js"
  },
  "bin": {
    "orch": "./src/cli.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "examples",
    "scripts",
    "docs",
    "README.md",
    "README.en.md",
    "STATUS.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node examples/script-demo.js",
    "view": "node src/viewer.js",
    "quickstart": "node scripts/quickstart.mjs"
  },
  "license": "MIT"
}
